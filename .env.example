BASE_URL=https://momuat.azpdl.net
TEST_USER=H51283
TEST_PASS=你的密码
# 角色三选一
TEST_ROLE=胖东来-IT
TEST_ROLE_CODE=
TEST_ROLE_ID=
# 被测前端源码根；不设则默认 ../../repos/pdl-front
TARGET_PROJECT=../../repos/pdl-front
LOG_LEVEL=info
PLAYWRIGHT_BROWSERS_PATH=C:\Users\Dxming\AppData\Local\ms-playwright
CHROME_PATH=C:\Users\Dxming\AppData\Local\ms-playwright\chromium-1243\chrome-win64\chrome.exe

# analyze 强制 LLM，缺少 key 或调用失败会直接报错（无启发式兜底）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 推荐 deepseek-chat；deepseek-flash / reasoner 也可能可用
DEEPSEEK_MODEL=deepseek-chat

# LLM 接入方式：api（默认，走上面的 DEEPSEEK_*）| handoff（文件交接，供呆呆鸟等外部 agent 应答，无需 key）
# handoff 流程见 src/analyzer/deepseekClient.ts 顶部注释与 README「LLM 文件交接模式」
LLM_MODE=api
# handoff 请求/应答目录，默认 artifacts/_llm-handoff
# LLM_HANDOFF_DIR=artifacts/_llm-handoff

# 自动化落库测试数据统一前缀（默认 autotest），suite 中以 ${ENV.TEST_DATA_PREFIX} 引用
# TEST_DATA_PREFIX=autotest
